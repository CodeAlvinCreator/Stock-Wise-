DATABASE_URL=sqlite:///stockwise.db
# Use at least 32 random characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
FLASK_APP=run.py
# Websites allowed to call the API, comma separated. Defaults to the Vite dev server.
CORS_ORIGINS=http://localhost:5173
